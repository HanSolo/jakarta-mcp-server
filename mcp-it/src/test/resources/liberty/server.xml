<?xml version="1.0" encoding="UTF-8"?>
<!-- Open Liberty configuration for the integration tests: the whole Jakarta EE 11 platform, the example WAR at the root, plain HTTP on 9080. -->
<server description="mcp integration tests">
    <featureManager>
        <feature>jakartaee-11.0</feature>
    </featureManager>
    <!-- the tests look for the INFO lines the example tools log; Liberty's console shows AUDIT and above by default -->
    <logging consoleLogLevel="INFO"/>
    <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" httpsPort="-1"/>
    <webApplication id="mcp-example" location="ROOT.war" contextRoot="/"/>
</server>
