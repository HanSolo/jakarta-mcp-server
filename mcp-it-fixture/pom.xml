<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.hansolo.mcp</groupId>
        <artifactId>jakarta-mcp-server</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-it-fixture</artifactId>
    <packaging>war</packaging>
    <name>Jakarta MCP Server (integration test fixture WAR)</name>
    <description>An unauthenticated admin endpoint, a notification bridge over HTTP and a tool with a nested schema, for the integration tests only. Never deploy this anywhere that is reachable by others.</description>

    <dependencies>
        <dependency>
            <groupId>eu.hansolo.mcp</groupId>
            <artifactId>mcp-jakarta</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- the JDBC task store and its driver, used only when the tests set MCP_TASKS_JDBC_URL (TasksClusterIT); otherwise the store reports itself as not available -->
        <dependency>
            <groupId>eu.hansolo.mcp</groupId>
            <artifactId>mcp-jakarta-tasks-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>mcp-it-fixture</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
