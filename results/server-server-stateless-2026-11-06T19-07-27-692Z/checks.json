  {
    "id": "sep-2575-server-unsupported-version-error",
    "name": "ServerUnsupportedVersionError",
    "description": "If the server does not implement the requested version (whether the version is unknown to the server, or is a known version the server has chosen not to support), it MUST respond with an UnsupportedProtocolVersionError listing the versions it does support; the error data carries the supported versions and echoes the requested version.",
    "status": "SUCCESS",
    "timestamp": "2026-11-06T19:07:27.693Z",
    "specReferences": [
      {
        "id": "SEP-2575",
        "url": "https://github.com/modelcontextprotocol/modelcontextprotocol/pull/2575"
      }
    ],
    "details": {
      "response": {
        "jsonrpc": "2.0",
        "id": 301,
        "error": {
          "code": -32022,
          "message": "Unsupported protocol version",
          "data": {
            "supported": [
              "2026-07-28"
            ],
            "requested": "v999.0.0"
          }
        }
      }
    }
  },
