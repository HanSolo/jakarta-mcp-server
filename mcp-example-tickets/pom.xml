<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.hansolo.mcp</groupId>
        <artifactId>jakarta-mcp-server</artifactId>
        <version>0.5.0</version>
    </parent>

    <artifactId>mcp-example-tickets</artifactId>
    <packaging>war</packaging>
    <name>Jakarta MCP Server (tickets example WAR)</name>
    <description>A realistic example: a support-ticket application with JPA persistence, exposed through MCP tools, resources, a prompt and completions, protected by OAuth scopes.</description>

    <dependencies>
        <dependency>
            <groupId>eu.hansolo.mcp</groupId>
            <artifactId>mcp-jakarta</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
        </dependency>
        <!-- Bundled so the example needs no datasource configuration on any server. A real application would use the server's JTA datasource instead. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>
        <dependency>
            <!-- the JSON-P implementation for the unit tests; the application server provides one at runtime -->
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
        <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            </dependency>
    </dependencies>

    <build>
        <finalName>mcp-example-tickets</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
