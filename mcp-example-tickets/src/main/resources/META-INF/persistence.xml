<?xml version="1.0" encoding="UTF-8"?>
<!--
  A resource-local unit with an embedded in-memory H2, so the example runs on any Jakarta EE server without configuring a
  datasource. A real application would use transaction-type="JTA" and the server's datasource (<jta-data-source>).
  Version 3.0 of the schema is accepted by every Jakarta Persistence 3.x provider.
-->
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="tickets" transaction-type="RESOURCE_LOCAL">
        <class>eu.hansolo.mcp.tickets.Ticket</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:tickets;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
        </properties>
    </persistence-unit>
</persistence>
