<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- groupId and Java packages follow the eu.hansolo namespace. -->
    <groupId>eu.hansolo.mcp</groupId>
    <artifactId>jakarta-mcp-server</artifactId>
    <version>0.5.0</version>
    <packaging>pom</packaging>

    <name>Jakarta MCP Server (parent)</name>
    <description>Stateless Model Context Protocol (spec 2026-07-28) server for Jakarta EE 11 / Payara 7</description>

    <url>https://github.com/HanSolo/jakarta-mcp-server</url>
    <inceptionYear>2026</inceptionYear>

    <scm>
        <url>https://github.com/HanSolo/jakarta-mcp-server</url>
        <connection>scm:git:https://github.com/HanSolo/jakarta-mcp-server.git</connection>
        <developerConnection>scm:git:git@github.com:HanSolo/jakarta-mcp-server.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/HanSolo/jakarta-mcp-server/issues</url>
    </issueManagement>

    <!-- Maven Central requires a developer entry; replace the name with the one you want shown. -->
    <developers>
        <developer>
            <id>HanSolo</id>
            <name>HanSolo</name>
            <url>https://github.com/HanSolo</url>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>mcp-jakarta</module>
        <module>mcp-example</module>
        <module>mcp-example-tickets</module>
        <module>mcp-example-conformance</module>
        <module>mcp-example-apps</module>
        <module>mcp-it-fixture</module>
        <module>mcp-it</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bytecode level 21 runs on every server image that ships JDK 21 or newer (class files compiled for 25 fail to load on a JDK 21 server: WildFly's jdk21 image showed this). The code uses nothing newer than 21; build and run on JDK 25 as you like. Override with -Dmaven.compiler.release=25 only if all your servers run JDK 25. -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Versions below were written from memory and could not be resolved in the authoring sandbox: bump to current if a build complains. -->
        <jakartaee.version>11.0.0</jakartaee.version>
        <parsson.version>1.1.7</parsson.version>
        <h2.version>2.3.232</h2.version>
        <junit.version>5.13.4</junit.version>
        <testcontainers.version>2.0.1</testcontainers.version>
        <failsafe.plugin.version>3.5.3</failsafe.plugin.version>

        <!-- Integration tests: which server to run against (payara, wildfly or liberty) and, optionally, which image. Empty image = the default for that server. Pin tags you have verified, e.g. -Dmcp.image=payara/micro:<tag>. -->
        <mcp.server>payara</mcp.server>
        <mcp.image></mcp.image>
        <payara.image></payara.image>
        <!-- Keycloak image for McpKeycloakIT; empty = quay.io/keycloak/keycloak:26.4 -->
        <keycloak.image></keycloak.image>

        <compiler.plugin.version>3.14.0</compiler.plugin.version>
        <surefire.plugin.version>3.5.3</surefire.plugin.version>
        <resources.plugin.version>3.3.1</resources.plugin.version>
        <war.plugin.version>3.4.0</war.plugin.version>
        <jar.plugin.version>3.4.2</jar.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-web-api</artifactId>
                <version>${jakartaee.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.parsson</groupId>
                <artifactId>parsson</artifactId>
                <version>${parsson.version}</version>
                <scope>test</scope>
                <exclusions>
                    <exclusion>
                        <groupId>jakarta.json</groupId>
                        <artifactId>jakarta.json-api</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${resources.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${war.plugin.version}</version>
                    <configuration>
                        <failOnMissingWebXml>false</failOnMissingWebXml>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <!--
          Publishing to Maven Central through the Central Portal:  mvn -Prelease clean deploy -pl .,mcp-jakarta
          Needs a server "central" in ~/.m2/settings.xml (portal user token) and a GPG key. The upload is not published automatically:
          check the validated bundle in the portal and press Publish (set autoPublish to true to skip that). Only mcp-jakarta and this
          parent POM may be uploaded, hence -pl: the plugin bundles every module in the build, and the upload happens after the last one.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>